# Credentials stay in the local FastAPI process. Never commit .env.
GATE_API_KEY=
GATE_API_SECRET=
# The web console executes real CFD strategies started by the user.
# Windows-encrypted credentials configured in the page take precedence.
GRID_DATABASE=data/live.sqlite3
# Optional: explicit public hostnames/IPs accepted behind the HTTPS proxy.
GRID_ALLOWED_HOSTS=
# Linux installer configures a private key file for encrypted Gate credentials.
# GRID_CREDENTIAL_KEY_FILE=/var/lib/grid-studio-keys/credential.key
# Access verifier lives in data/access-control.json, never plaintext in source.
# scripts/configure_access.py can replace the deployment default token.
