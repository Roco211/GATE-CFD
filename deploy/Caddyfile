{
    # Browsers omit SNI for literal IP URLs. Docker's private address cannot
    # select the public IP certificate, so use the configured public host.
    default_sni {$GRID_PUBLIC_HOST}
}

{$GRID_PUBLIC_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode zstd gzip
    request_body {
        max_size 1MB
    }
    reverse_proxy grid:18473 {
        flush_interval -1
    }
}
